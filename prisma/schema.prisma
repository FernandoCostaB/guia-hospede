generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Property {
  id                    Int      @id @default(autoincrement())
  code                  String   @unique
  name                  String
  propertyType          String
  bedroomQuantity       Int
  bathroomQuantity      Int
  guestCapacity         Int
  street                String
  number                String
  complement            String?
  neighborhood          String
  city                  String
  state                 String
  postalCode            String
  wifiNetwork           String
  wifiPassword          String
  isSelfCheckin         Boolean
  accessType            String
  accessInstructions    String
  accessPassword        String
  hasParking            Boolean
  parkingIdentifier     String?
  parkingInstructions   String?
  checkInTime           String
  checkOutTime          String
  allowPet              Boolean
  smokingPermitted      Boolean
  suitableForChildren   Boolean
  suitableForBabies     Boolean
  eventsPermitted       Boolean
  amenities             Json
  images                Json
  hostName              String
  hostPhone             String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  experienceGuide ExperienceGuide?
}

enum GuideStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

model ExperienceGuide {
  id           Int         @id @default(autoincrement())
  propertyId   Int         @unique
  property     Property    @relation(fields: [propertyId], references: [id])
  status       GuideStatus @default(PENDING)
  content      Json?
  errorMessage String?
  generatedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}
